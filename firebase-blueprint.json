{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Account profile for a Candidate (Job Seeker) or Employer (Recruiter) on Nature Island Careers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The Firebase Authentication UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's registered email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "description": "Full legal name of the candidate or primary contact person for the employer.",
          "minLength": 2,
          "maxLength": 120
        },
        "accountType": {
          "type": "string",
          "description": "Non-privileged account type: candidate or employer.",
          "enum": ["candidate", "employer"]
        },
        "parish": {
          "type": "string",
          "description": "Dominica parish of residence or headquarters.",
          "minLength": 2,
          "maxLength": 64
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone number.",
          "minLength": 4,
          "maxLength": 40
        },
        "companyName": {
          "type": "string",
          "description": "Organization name for employer accounts.",
          "minLength": 1,
          "maxLength": 140
        },
        "dssRegistrationNo": {
          "type": "string",
          "description": "Dominica Social Security employer registration number.",
          "minLength": 1,
          "maxLength": 64
        },
        "careerSector": {
          "type": "string",
          "description": "Primary career or industry sector.",
          "minLength": 2,
          "maxLength": 100
        },
        "skills": {
          "type": "array",
          "description": "Bounded list of up to 10 key professional skills.",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "name",
        "accountType",
        "parish",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmailCategorySubscription": {
      "title": "EmailCategorySubscription",
      "description": "Email job category subscription linked to an authenticated user account for automated Dominica vacancy notifications.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic subscription document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "The Firebase Authentication UID of the subscription owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Recipient email address for job category alerts.",
          "minLength": 3,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "description": "Subscriber display name.",
          "minLength": 2,
          "maxLength": 120
        },
        "categories": {
          "type": "array",
          "description": "Bounded list of up to 10 subscribed Dominica job categories/sectors.",
          "maxLength": 10
        },
        "parishes": {
          "type": "array",
          "description": "Bounded list of up to 11 Dominica parishes.",
          "maxLength": 11
        },
        "frequency": {
          "type": "string",
          "description": "Automated email digest frequency.",
          "enum": ["instant", "daily", "weekly"]
        },
        "active": {
          "type": "boolean",
          "description": "Whether automated notifications are currently active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the subscription was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the subscription was last updated."
        }
      },
      "required": [
        "id",
        "uid",
        "email",
        "categories",
        "frequency",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmployerInvoice": {
      "title": "EmployerInvoice",
      "description": "Employer membership invoice record including payment status, description, and pending payment expiry date.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique invoice document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the employer owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recruiterId": {
          "type": "string",
          "description": "Recruiter organization identifier.",
          "minLength": 1,
          "maxLength": 128
        },
        "companyName": {
          "type": "string",
          "description": "Employer company name.",
          "minLength": 1,
          "maxLength": 140
        },
        "recipientEmail": {
          "type": "string",
          "format": "email",
          "description": "Employer billing contact email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Human-readable invoice reference number.",
          "minLength": 3,
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "ISO issue date of the invoice.",
          "minLength": 4,
          "maxLength": 40
        },
        "expiryDate": {
          "type": "string",
          "description": "ISO expiry timestamp or date for pending invoices.",
          "minLength": 4,
          "maxLength": 64
        },
        "plan": {
          "type": "string",
          "description": "Purchased employer membership plan name.",
          "minLength": 2,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "description": "Itemized invoice description for keyword search and audit.",
          "minLength": 2,
          "maxLength": 400
        },
        "amountXCD": {
          "type": "number",
          "description": "Invoice amount in Eastern Caribbean Dollars (XCD)."
        },
        "amountUSD": {
          "type": "number",
          "description": "Invoice amount in United States Dollars (USD)."
        },
        "billingInterval": {
          "type": "string",
          "description": "Billing cadence for the membership.",
          "enum": ["monthly", "one_time", "annual"]
        },
        "status": {
          "type": "string",
          "description": "Current settlement status of the invoice.",
          "enum": ["Paid", "Pending", "Processing", "Renewal Pending", "Failed", "Canceled", "Refunded"]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment channel or card descriptor.",
          "minLength": 2,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the invoice was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the invoice was last updated."
        }
      },
      "required": [
        "id",
        "uid",
        "recruiterId",
        "companyName",
        "invoiceNumber",
        "date",
        "plan",
        "amountXCD",
        "amountUSD",
        "billingInterval",
        "status",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores isolated account profile data for candidates and employers, strictly accessible only by the document owner."
    },
    "/users/{userId}/emailSubscriptions/{subscriptionId}": {
      "schema": {
        "$ref": "#/entities/EmailCategorySubscription"
      },
      "description": "Stores email job category alert subscriptions per verified user for automated vacancy notifications."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": {
        "$ref": "#/entities/EmployerInvoice"
      },
      "description": "Stores employer membership invoices, payment statuses, and pending expiry dates isolated by account owner."
    }
  }
}
